---
import PageLayout from '../layouts/PageLayout.astro';
import { destinations, photo } from '../data/travel';
const trips = destinations.slice(0, 3);
---

<PageLayout title="Wanderwell — Find your somewhere" description="Thoughtful journeys, made personal. Discover handpicked escapes and plan your next great adventure with Wanderwell." overlayHeader={true}>
	<main>
		<section class="hero" id="home" aria-label="Discover your next journey">
			<div class="hero-image" aria-hidden="true"></div>
			<div class="hero-shade" aria-hidden="true"></div>
			<div class="hero-content">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> GO A LITTLE FURTHER</p>
					<h1>Find your<br /><em>somewhere.</em></h1>
					<p class="hero-intro">The best stories start somewhere new. Find the places, people, and little moments that stay with you long after you get home.</p>
					<div class="hero-actions"><a class="button button-light" href="/destinations/">Explore journeys <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/"><span class="play">▶</span> Our way of travelling</a></div>
				</div>
				<div class="hero-note"><span class="note-line"></span><span>THE WORLD IS<br />WAITING OUT THERE</span></div>
			</div>
			<div class="hero-bottom"><span>45° 55' 0.0" N &nbsp; 7° 52' 0.0" E</span><span class="scroll-cue">SCROLL TO WANDER <b>↓</b></span><span>EST. 2014 &nbsp;·&nbsp; EVERYWHERE</span></div>
			<div class="hero-index"><strong>01</strong><span></span>03</div>
		</section>

		<section class="planner" id="plan" aria-labelledby="planner-title">
			<div class="planner-heading"><span class="section-kicker">A GOOD PLACE TO BEGIN</span><h2 id="planner-title">Where to next?</h2></div>
			<form class="search-form" id="trip-form" action="/destinations/" method="get">
				<label class="field"><span class="field-icon">⌖</span><span><small>I WANT TO GO TO</small><select name="destination" aria-label="Choose a destination"><option value="">Choose a destination</option><option value="switzerland">Switzerland</option><option value="italy">Italy</option><option value="japan">Japan</option><option value="anywhere">Anywhere, surprise me</option></select></span></label>
				<label class="field date-field"><span class="field-icon">□</span><span><small>WHEN ARE YOU GOING?</small><input type="month" name="month" aria-label="Travel month" /></span></label>
				<label class="field"><span class="field-icon">♧</span><span><small>WHO'S COMING ALONG?</small><select name="travelers" aria-label="Number of travelers"><option>2 travelers</option><option>1 traveler</option><option>3 travelers</option><option>4+ travelers</option></select></span></label>
				<button class="button button-dark" type="submit">Find my trip <span aria-hidden="true">↗</span></button>
			</form>
			<p class="form-message" aria-live="polite"></p>
		</section>

		<section class="journeys section-wrap" id="journeys">
			<div class="section-head"><div><span class="section-kicker">A FEW PLACES WE LOVE</span><h2>Good things are<br /><em>just around the bend.</em></h2></div><a class="underlined-link" href="/destinations/">See all journeys <span>↗</span></a></div>
			<div class="trip-grid">
				{trips.map((trip, i) => <article class="trip-card">
					<a class="trip-image" href={`/destinations/${trip.slug}/`} aria-label={`Explore ${trip.name}`} style={`--trip-image: url('${photo(trip.image, 850)}')`}>
						<span class="trip-tag">{trip.tag}</span><span class="trip-arrow" aria-hidden="true">↗</span>
					</a>
					<div class="trip-meta"><span>0{i + 1} &nbsp; / &nbsp; {trip.country.toUpperCase()}</span><span>✳ &nbsp; CURATED FOR YOU</span></div>
					<h3>{trip.name}</h3><p>{trip.days} days · from ${trip.price.toLocaleString()}</p>
				</article>)}
			</div>
		</section>

		<section class="manifesto" id="about">
			<div class="manifesto-image" role="img" aria-label="A quiet mountain lake surrounded by peaks" style={`background-image:url('${photo('photo-1500530855697-b586d89ba3ee', 1600)}')`}></div>
			<div class="manifesto-copy"><span class="section-kicker">A DIFFERENT KIND OF TRAVEL</span><h2>Less itinerary.<br /><em>More feeling.</em></h2><p>We believe the best trips leave room for the unexpected. So we bring together local know-how, thoughtful details, and places with a pulse to make travel feel like yours.</p><a class="underlined-link" href="/about/">Get to know us <span>↗</span></a><div class="stat-row"><div><strong>10<span>+</span></strong><small>YEARS WANDERING</small></div><div><strong>32</strong><small>COUNTRIES, AND COUNTING</small></div><div><strong>4.9<span>/5</span></strong><small>TRAVELLER RATING</small></div></div></div>
		</section>

		<section class="quote-section" id="journal"><span class="section-kicker">NOTES FROM THE ROAD</span><div class="quote-mark">“</div><blockquote>We came home with sandy shoes, a hundred new friends, and the feeling that we’d found a second home.</blockquote><p class="quote-credit">MAYA & JAMES &nbsp;·&nbsp; PORTUGAL, 2025</p><div class="quote-dots"><span class="active"></span><span></span><span></span></div><a class="underlined-link" href="/journal/">Read the journal <span>↗</span></a></section>

		<section class="closing-cta"><div><span class="section-kicker">YOUR NEXT CHAPTER STARTS HERE</span><h2>Somewhere is<br /><em>calling.</em></h2></div><a class="button button-light" href="/contact/?reason=trip">Let’s find it <span aria-hidden="true">↗</span></a><span class="cta-orbit" aria-hidden="true">✳</span></section>
	</main>
</PageLayout>

<style>
	:global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth;scroll-padding-top:28px} :global(body){margin:0;background:#f6f4ef;color:#222924;font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased} :global(a){color:inherit;text-decoration:none} :global(button),:global(input),:global(select){font:inherit}
	.hero{position:relative;min-height:760px;height:min(100vh,1000px);max-height:1050px;margin:18px 20px 0;border-radius:5px;overflow:hidden;color:#fff;background:#344a45;isolation:isolate}.hero-image,.hero-shade{position:absolute;inset:0;z-index:-1}.hero-image{background-image:url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2400&q=90');background-size:cover;background-position:center 48%;transform:scale(1.01)}.hero-shade{background:linear-gradient(90deg,rgba(14,31,29,.57) 0%,rgba(18,34,32,.3) 52%,rgba(12,26,25,.13) 100%),linear-gradient(0deg,rgba(10,24,23,.39),transparent 27%,rgba(9,23,24,.22))}.topbar{height:100px;padding:0 6.2%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.25);position:relative;z-index:2}.brand{display:flex;gap:11px;align-items:center;font-size:12px;font-weight:700;letter-spacing:.16em}.brand-mark{display:grid;place-items:center;width:35px;height:35px;border:1px solid rgba(255,255,255,.8);border-radius:50%;font-family:Georgia,serif;font-size:20px;font-weight:400;letter-spacing:-.1em;padding-right:3px}.nav-links{display:flex;gap:40px;font-size:13px;color:rgba(255,255,255,.89)}.nav-links a,.footer a{transition:opacity .2s}.nav-links a:hover,.footer a:hover{opacity:.65}.nav-cta{border:1px solid rgba(255,255,255,.7);border-radius:3px;padding:12px 17px;font-size:12px;letter-spacing:.03em}.nav-cta span{margin-left:17px}.menu-toggle{display:none}.hero-content{height:calc(100% - 160px);max-width:1330px;margin:auto;padding:0 7%;display:flex;align-items:center;position:relative}.hero-copy{max-width:630px;margin-top:-8px}.eyebrow,.section-kicker{font-size:10px;letter-spacing:.19em;font-weight:700}.eyebrow{display:flex;gap:11px;align-items:center;margin:0 0 24px}.eyebrow span{width:25px;height:1px;background:#e5a963}.hero h1{font-family:Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.055em;font-size:clamp(62px,8vw,116px);line-height:.91;margin:0}.hero h1 em,.section-head h2 em,.manifesto h2 em,.closing-cta h2 em{font-weight:400}.hero-intro{max-width:400px;color:rgba(255,255,255,.82);font-size:14px;line-height:1.8;margin:26px 0 29px}.hero-actions{display:flex;align-items:center;gap:25px}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:30px;padding:16px 19px;font-size:12px;font-weight:700;border:0;border-radius:2px;cursor:pointer;transition:transform .2s,background .2s}.button:hover{transform:translateY(-2px)}.button span{font-size:16px}.button-light{background:#f6f4ef;color:#26332c}.text-link{font-size:11px;color:rgba(255,255,255,.9)}.play{display:inline-grid;place-items:center;border:1px solid rgba(255,255,255,.7);width:26px;height:26px;border-radius:50%;font-size:8px;margin-right:9px}.hero-note{position:absolute;right:7%;bottom:24%;display:flex;gap:13px;align-items:center;color:rgba(255,255,255,.85);font-size:9px;letter-spacing:.15em;line-height:1.7}.note-line{width:39px;height:1px;background:#e5a963}.hero-bottom{position:absolute;bottom:0;left:0;right:0;min-height:60px;padding:0 6.2%;border-top:1px solid rgba(255,255,255,.25);display:flex;align-items:center;justify-content:space-between;color:rgba(255,255,255,.78);font-size:9px;letter-spacing:.12em}.scroll-cue{display:flex;gap:14px;align-items:center}.scroll-cue b{font-size:16px;font-weight:400}.hero-index{position:absolute;right:6.2%;top:47%;display:flex;gap:8px;align-items:center;font-size:9px;letter-spacing:.08em}.hero-index strong{font-size:13px}.hero-index span{width:40px;height:1px;background:#fff}
	.planner{max-width:1210px;margin:-1px auto 0;padding:46px 38px 36px;background:#fff;position:relative;z-index:1;box-shadow:0 18px 45px #25372a0d;display:grid;grid-template-columns:210px 1fr;align-items:center;column-gap:28px}.section-kicker{color:#748171;font-size:9px}.planner h2{font-family:Georgia,serif;font-size:28px;font-weight:400;margin:8px 0 0;letter-spacing:-.03em}.search-form{display:grid;grid-template-columns:1.2fr 1fr 1fr auto;align-items:center;gap:0}.field{display:flex;gap:11px;align-items:center;padding:0 18px;border-left:1px solid #e9e9e4;min-width:0}.field-icon{font-size:21px;color:#78866f;font-weight:300}.field small{display:block;white-space:nowrap;color:#93958c;font-size:8px;letter-spacing:.1em;font-weight:700;margin-bottom:7px}.field select,.field input{width:100%;border:0;background:transparent;color:#353b35;font-size:12px;outline:none}.field select{appearance:none;cursor:pointer}.date-field input{min-width:112px}.button-dark{background:#31443b;color:#fff;margin-left:14px;white-space:nowrap}.form-message{grid-column:2;margin:13px 0 0;color:#667561;font-size:12px;min-height:0}.form-message:empty{display:none}
	.section-wrap{max-width:1210px;margin:0 auto;padding:112px 38px 118px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:42px}.section-head h2,.manifesto h2,.closing-cta h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(38px,5vw,62px);line-height:1.05;font-weight:400;letter-spacing:-.045em;margin:15px 0 0}.underlined-link{font-size:11px;padding-bottom:8px;border-bottom:1px solid #8b9385;display:inline-flex;gap:34px;align-items:center}.underlined-link span{font-size:15px}.trip-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.trip-image{display:block;position:relative;height:330px;background-image:var(--trip-image);background-size:cover;background-position:center;overflow:hidden}.trip-image:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(14,25,21,.18),transparent 50%);transition:background .2s}.trip-image:hover:after{background:rgba(14,25,21,.13)}.trip-tag{position:absolute;top:16px;left:16px;z-index:1;padding:8px 11px;background:#fff;color:#485549;border-radius:2px;font-size:9px;letter-spacing:.04em}.trip-arrow{position:absolute;right:16px;bottom:16px;z-index:1;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#fff;color:#34443b;font-size:16px}.trip-meta{margin-top:18px;display:flex;justify-content:space-between;gap:8px;font-size:8px;letter-spacing:.13em;color:#81877d}.trip-meta span:last-child{color:#9a9a8f}.trip-card h3{font-family:Georgia,serif;font-size:25px;font-weight:400;letter-spacing:-.02em;margin:11px 0 5px}.trip-card>p{font-size:11px;color:#74786e;margin:0}
	.manifesto{display:grid;grid-template-columns:1fr 1fr;min-height:610px;background:#e8e9e1}.manifesto-image{background-size:cover;background-position:center}.manifesto-copy{padding:90px clamp(45px,8vw,130px) 54px}.manifesto h2{font-size:clamp(43px,5vw,68px);margin:16px 0 22px}.manifesto-copy>p{max-width:420px;font-size:13px;line-height:1.9;color:#62695e;margin:0 0 25px}.manifesto .underlined-link{margin-bottom:62px}.stat-row{display:flex;gap:35px;border-top:1px solid #cdd0c6;padding-top:25px}.stat-row>div{display:flex;flex-direction:column;gap:7px}.stat-row strong{font-family:Georgia,serif;font-size:30px;font-weight:400;letter-spacing:-.04em}.stat-row strong span{font-size:16px}.stat-row small{font-size:8px;letter-spacing:.1em;color:#767c71;white-space:nowrap}
	.quote-section{text-align:center;max-width:800px;padding:110px 30px 100px;margin:auto}.quote-mark{font-family:Georgia,serif;font-size:66px;line-height:1;color:#a5af9c;margin-top:17px}.quote-section blockquote{font-family:Georgia,serif;font-size:clamp(24px,3.2vw,38px);line-height:1.35;letter-spacing:-.025em;margin:0 auto 22px;max-width:720px}.quote-credit{font-size:9px;letter-spacing:.16em;color:#858a7e}.quote-dots{display:flex;justify-content:center;gap:7px;margin-top:28px}.quote-dots span{width:5px;height:5px;background:#d2d4cc;border-radius:50%}.quote-dots .active{background:#5d6a5b}
	.closing-cta{position:relative;overflow:hidden;display:flex;justify-content:space-between;align-items:center;background:#34483e;color:#fff;padding:82px max(calc((100% - 1134px)/2),8%);min-height:320px}.closing-cta .section-kicker{color:#c0c9b8}.closing-cta h2{font-size:clamp(45px,6vw,74px);margin-top:12px}.closing-cta .button{z-index:1}.cta-orbit{position:absolute;right:25%;top:-80px;color:#ffffff0b;font-size:370px;line-height:1}
	.footer{min-height:105px;padding:26px max(calc((100% - 1210px)/2),6%);display:flex;align-items:center;justify-content:space-between;gap:20px;color:#5c665c}.footer-brand .brand-mark{border-color:#718071}.footer-brand{color:#354339}.footer>span,.footer small,.footer>div{font-size:8px;letter-spacing:.13em}.footer>div{display:flex;gap:22px}.footer small{white-space:nowrap}
	@media(max-width:1000px){.planner{grid-template-columns:1fr;gap:23px;margin:0 20px;padding:34px}.search-form{grid-template-columns:repeat(3,1fr);row-gap:22px}.field:first-child{border-left:0;padding-left:0}.button-dark{grid-column:1/-1;justify-self:start;margin-left:0}.form-message{grid-column:1}.hero{min-height:720px}.hero-note{right:6%;bottom:18%}.trip-image{height:270px}.manifesto-copy{padding:70px 48px 45px}.stat-row{gap:20px}.footer{flex-wrap:wrap}.footer>span{display:none}}
	@media(max-width:700px){.hero{margin:8px 8px 0;height:780px;min-height:calc(100svh - 8px);max-height:none;border-radius:3px}.hero-image{background-position:58% center}.hero-shade{background:linear-gradient(90deg,rgba(14,31,29,.6),rgba(18,34,32,.2)),linear-gradient(0deg,rgba(10,24,23,.43),transparent 35%,rgba(9,23,24,.25))}.topbar{height:73px;padding:0 22px}.brand{font-size:10px}.brand-mark{width:30px;height:30px;font-size:18px}.nav-cta{padding:10px 12px;font-size:10px;margin-left:auto;margin-right:14px}.nav-cta span{margin-left:8px}.menu-toggle{display:flex;position:relative;z-index:5;width:34px;height:34px;flex-direction:column;justify-content:center;gap:6px;border:1px solid #ffffff99;background:transparent;border-radius:50%;padding:8px}.menu-toggle span{display:block;height:1px;background:#fff;width:100%}.nav-links{display:none;position:absolute;top:72px;left:0;right:0;padding:20px 24px 25px;background:#304239;flex-direction:column;gap:20px;font-size:14px}.nav-links.is-open{display:flex}.hero-content{height:calc(100% - 132px);padding:0 8%;align-items:center}.hero-copy{margin-top:0}.hero h1{font-size:clamp(62px,15vw,92px)}.hero-intro{max-width:340px;font-size:13px;line-height:1.7;margin:22px 0}.hero-actions{gap:15px;flex-wrap:wrap}.button{padding:14px 15px}.text-link{font-size:10px}.hero-note{display:none}.hero-index{right:8%;top:auto;bottom:86px}.hero-bottom{min-height:50px;padding:0 6%;font-size:7px}.hero-bottom>span:first-child{display:none}.hero-bottom{justify-content:center}.hero-bottom>span:last-child{display:none}.planner{margin:0 8px;padding:28px 23px}.planner h2{font-size:25px}.search-form{grid-template-columns:1fr;gap:17px}.field{border-left:0;border-top:1px solid #e9e9e4;padding:15px 0 0}.field:first-child{border-top:0;padding-top:0}.date-field input{min-width:0}.button-dark{grid-column:auto}.section-wrap{padding:80px 22px}.section-head{align-items:start;gap:20px;flex-direction:column;margin-bottom:29px}.section-head h2,.manifesto h2{font-size:44px}.trip-grid{grid-template-columns:1fr;gap:34px}.trip-image{height:330px}.trip-meta{font-size:7px}.manifesto{grid-template-columns:1fr}.manifesto-image{min-height:360px}.manifesto-copy{padding:55px 25px 45px}.manifesto .underlined-link{margin-bottom:42px}.stat-row{gap:0;justify-content:space-between}.stat-row strong{font-size:25px}.stat-row small{font-size:7px;letter-spacing:.06em}.quote-section{padding:78px 25px}.quote-section blockquote{font-size:27px}.closing-cta{padding:59px 26px;min-height:280px;gap:18px;align-items:flex-end}.closing-cta h2{font-size:49px}.closing-cta .button{gap:14px;font-size:10px;padding:14px 12px;white-space:nowrap}.cta-orbit{right:-25%;font-size:260px}.footer{padding:25px 22px;gap:18px}.footer>div{gap:16px}.footer small{font-size:7px}}
	:global(html){scroll-padding-top:110px}.topbar{position:sticky;top:0;z-index:10;margin:0 20px -100px;transition:background .25s ease,border-color .25s ease}.topbar.is-scrolled{background:#34483e;border-bottom-color:transparent}
	@media(max-width:700px){:global(html){scroll-padding-top:82px}.topbar{margin:0 8px -73px}}
	@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.button{transition:none}.topbar{transition:none}}
</style>
