---
interface Props { overlay?: boolean; }
const { overlay = false } = Astro.props;
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
	<a class="site-brand" href="/" aria-label="Wanderwell home"><span class="site-brand-mark">w.</span><span>WANDERWELL</span></a>
	<button class="site-menu-toggle" aria-label="Open navigation" aria-expanded="false"><span></span><span></span></button>
	<nav class="site-nav" aria-label="Main navigation">
		<a href="/">Home</a><a href="/destinations/">Destinations</a><a href="/about/">Our story</a><a href="/journal/">Journal</a><a class="mobile-contact" href="/contact/">Contact</a>
	</nav>
	<a class="site-cta" href="/contact/?reason=trip">Plan a trip <span aria-hidden="true">↗</span></a>
</header>

<script>
	const header = document.querySelector<HTMLElement>('.site-header');
	const menuButton = header?.querySelector<HTMLButtonElement>('.site-menu-toggle');
	const nav = header?.querySelector<HTMLElement>('.site-nav');
	menuButton?.addEventListener('click', () => {
		const open = menuButton.getAttribute('aria-expanded') === 'true';
		menuButton.setAttribute('aria-expanded', String(!open));
		menuButton.setAttribute('aria-label', open ? 'Open navigation' : 'Close navigation');
		nav?.classList.toggle('is-open', !open);
	});
	nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
		menuButton?.setAttribute('aria-expanded', 'false');
		menuButton?.setAttribute('aria-label', 'Open navigation');
		nav.classList.remove('is-open');
	}));
</script>

<style>
	.site-header{height:82px;padding:0 max(calc((100% - 1280px)/2),5.5%);display:flex;align-items:center;justify-content:space-between;gap:25px;position:relative;z-index:20;background:#34483e;color:white;border-bottom:1px solid #ffffff26}
	.site-header--overlay{height:100px;margin:18px 20px -118px;padding-left:6.2%;padding-right:6.2%;background:transparent;border-bottom-color:#ffffff40}
	.site-brand{display:flex;gap:11px;align-items:center;font-size:12px;font-weight:700;letter-spacing:.16em;white-space:nowrap}.site-brand-mark{width:35px;height:35px;border:1px solid #ffffffbd;border-radius:50%;display:grid;place-items:center;font:20px Georgia,serif;letter-spacing:-.1em;padding-right:3px}
	.site-nav{display:flex;gap:clamp(18px,3.2vw,42px);align-items:center;font-size:13px;color:#ffffffe8}.site-nav a{transition:opacity .2s}.site-nav a:hover{opacity:.68}.mobile-contact{display:none}
	.site-cta{padding:12px 16px;border:1px solid #ffffffa6;border-radius:2px;font-size:11px;white-space:nowrap}.site-cta span{margin-left:15px;font-size:15px}.site-menu-toggle{display:none}
	@media(max-width:720px){.site-header{height:72px;padding:0 20px;gap:10px}.site-header--overlay{height:73px;margin:8px 8px -81px;padding:0 16px}.site-brand{font-size:10px;gap:8px}.site-brand-mark{width:30px;height:30px;font-size:18px}.site-cta{margin-left:auto;padding:10px 11px;font-size:10px}.site-cta span{margin-left:7px}.site-menu-toggle{display:flex;width:34px;height:34px;flex-direction:column;justify-content:center;gap:6px;border:1px solid #ffffff99;background:transparent;border-radius:50%;padding:8px;z-index:2}.site-menu-toggle span{height:1px;width:100%;background:#fff}.site-nav{display:none;position:absolute;left:0;right:0;top:100%;padding:20px 22px 24px;background:#34483e;flex-direction:column;align-items:flex-start;gap:20px;font-size:14px;box-shadow:0 12px 15px #14241b24}.site-nav.is-open{display:flex}.mobile-contact{display:inline}.site-header--overlay .site-nav{top:calc(100% - 1px)}}
	@media(prefers-reduced-motion:reduce){.site-header{transition:none}}
</style>
